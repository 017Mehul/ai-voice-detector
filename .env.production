# Production environment template. Configure these in your hosting provider.
# Do not put secrets in this tracked file.
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
ENABLE_DETAILED_LOGGING=false

API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
REQUEST_TIMEOUT=30
MAX_REQUEST_SIZE=52428800

ENABLE_CORS=true
# App is served by the same origin. Add only trusted external front-end origins if needed.
CORS_ORIGINS=https://ai-voice-detector-production-b5f3.up.railway.app
CORS_METHODS=GET,POST,OPTIONS
CORS_HEADERS=Content-Type,Authorization,X-Requested-With

MODEL_PATH=./models/voice_classifier.joblib
CALIBRATION_PATH=./models/calibration_params.joblib
MODEL_CONFIDENCE_THRESHOLD=0.5
ENABLE_FEATURE_IMPORTANCE=true
ENABLE_BATCH_PROCESSING=false

MAX_AUDIO_SIZE_MB=10
MAX_AUDIO_DURATION_SECONDS=30
MIN_AUDIO_DURATION_SECONDS=2
AUDIO_SAMPLE_RATE=22050
AUDIO_N_MFCC=13

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true
PROMETHEUS_PORT=9090

ENABLE_REQUEST_TRACKING=true
ENABLE_RESPONSE_CACHING=false
CACHE_TTL=300
ENABLE_COMPRESSION=true
MAX_CONCURRENT_REQUESTS=100

CONTAINER_NAME=ai-voice-detector
DEPLOYMENT_VERSION=1.0.1
