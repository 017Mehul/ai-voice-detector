# AI Voice Detection System - Production Environment Configuration
# This file contains production-ready environment variable settings
# Copy and customize these values for your production deployment

# =============================================================================
# CORE APPLICATION SETTINGS
# =============================================================================

# Environment type - MUST be set to 'production' for production deployments
ENVIRONMENT=production

# Debug mode - MUST be false in production for security and performance
DEBUG=false

# Logging level - Use INFO or WARNING in production to reduce log volume
LOG_LEVEL=INFO

# Enable detailed logging for troubleshooting (use sparingly in production)
ENABLE_DETAILED_LOGGING=false

# =============================================================================
# API SERVER CONFIGURATION
# =============================================================================

# API server host - Use 0.0.0.0 to accept connections from all interfaces
API_HOST=0.0.0.0

# API server port - Standard HTTP port or custom port
API_PORT=8000

# Number of worker processes - Recommended: 2 * CPU cores
API_WORKERS=4

# Request timeout in seconds - Balance between user experience and resource usage
REQUEST_TIMEOUT=30

# Maximum request size in bytes (50MB default for large audio files)
MAX_REQUEST_SIZE=52428800

# =============================================================================
# CORS (Cross-Origin Resource Sharing) CONFIGURATION
# =============================================================================

# Enable CORS - Set to false if using reverse proxy for CORS handling
ENABLE_CORS=true

# Allowed origins - Specify exact domains in production, avoid wildcards
# Example: https://yourdomain.com,https://api.yourdomain.com
CORS_ORIGINS=*

# Allowed HTTP methods
CORS_METHODS=GET,POST,OPTIONS

# Allowed headers
CORS_HEADERS=Content-Type,Authorization,X-Requested-With

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================

# Path to the trained classification model
MODEL_PATH=./models/production/model.joblib

# Confidence threshold for classification decisions (0.0 to 1.0)
MODEL_CONFIDENCE_THRESHOLD=0.5

# Enable feature importance calculation for explainability
ENABLE_FEATURE_IMPORTANCE=true

# Enable batch processing for multiple audio files (if implemented)
ENABLE_BATCH_PROCESSING=false

# =============================================================================
# AUDIO PROCESSING SETTINGS
# =============================================================================

# Maximum audio file size in MB - Balance between functionality and resource usage
MAX_AUDIO_SIZE_MB=10

# Maximum audio duration in seconds - Prevent resource exhaustion
MAX_AUDIO_DURATION_SECONDS=30

# Minimum audio duration in seconds - Ensure sufficient data for analysis
MIN_AUDIO_DURATION_SECONDS=2

# Audio sample rate for processing - 22050 Hz is optimal for voice analysis
AUDIO_SAMPLE_RATE=22050

# Number of MFCC coefficients to extract - 13 is standard for voice analysis
AUDIO_N_MFCC=13

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================

# Enable rate limiting to prevent abuse
RATE_LIMIT_ENABLED=true

# Maximum requests per time window
RATE_LIMIT_REQUESTS=100

# Time window in seconds for rate limiting
RATE_LIMIT_WINDOW=60

# =============================================================================
# MONITORING AND HEALTH CHECKS
# =============================================================================

# Enable health check endpoint (/health)
HEALTH_CHECK_ENABLED=true

# Enable metrics collection for monitoring
METRICS_ENABLED=true

# Port for Prometheus metrics endpoint
PROMETHEUS_PORT=9090

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# API key for authentication (if implemented)
# API_KEY=your-secure-api-key-here

# JWT secret for token authentication (if implemented)
# JWT_SECRET=your-jwt-secret-here

# Enable request ID tracking for security auditing
ENABLE_REQUEST_TRACKING=true

# =============================================================================
# DATABASE CONFIGURATION (Optional - for logging/analytics)
# =============================================================================

# Database URL for storing request logs and analytics
# DATABASE_URL=postgresql://username:password@localhost:5432/ai_voice_detector

# Database connection pool settings
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================

# Sentry DSN for error tracking and monitoring
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Redis URL for caching and session storage
# REDIS_URL=redis://localhost:6379/0

# Email service configuration for alerts
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# ALERT_EMAIL_TO=admin@yourdomain.com

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Enable response caching for identical requests
ENABLE_RESPONSE_CACHING=false

# Cache TTL in seconds (if caching is enabled)
CACHE_TTL=300

# Enable request compression
ENABLE_COMPRESSION=true

# Maximum concurrent requests per worker
MAX_CONCURRENT_REQUESTS=100

# =============================================================================
# DEPLOYMENT SPECIFIC SETTINGS
# =============================================================================

# Container/Pod name for logging and monitoring
CONTAINER_NAME=ai-voice-detector

# Deployment version for tracking
DEPLOYMENT_VERSION=1.0.0

# Kubernetes namespace (if deploying to Kubernetes)
# K8S_NAMESPACE=ai-voice-detector

# Cloud provider specific settings
# AWS_REGION=us-west-2
# GCP_PROJECT_ID=your-project-id
# AZURE_RESOURCE_GROUP=your-resource-group

# =============================================================================
# BACKUP AND DISASTER RECOVERY
# =============================================================================

# Enable automatic model backup
ENABLE_MODEL_BACKUP=false

# Backup interval in hours
MODEL_BACKUP_INTERVAL=24

# Backup storage location
# BACKUP_STORAGE_URL=s3://your-backup-bucket/models/

# =============================================================================
# COMPLIANCE AND AUDITING
# =============================================================================

# Enable audit logging for compliance
ENABLE_AUDIT_LOGGING=true

# Audit log retention period in days
AUDIT_LOG_RETENTION_DAYS=90

# Enable data privacy features
ENABLE_DATA_PRIVACY=true

# Automatically delete processed audio data after response
AUTO_DELETE_AUDIO_DATA=true