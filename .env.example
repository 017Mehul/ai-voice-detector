# AI Voice Detection System - Environment Configuration Template
# 
# IMPORTANT: This is a template file for development and testing.
# For production deployment, use .env.production as a starting point.
#
# Quick Setup:
# 1. Development: cp .env.example .env
# 2. Production: python scripts/configure_production_env.py --interactive
#
# Copy this file to .env and customize the values

# =============================================================================
# CORE APPLICATION SETTINGS
# =============================================================================

# Environment type: development, testing, production
ENVIRONMENT=development

# Debug mode - MUST be false in production
DEBUG=true

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# API SERVER CONFIGURATION
# =============================================================================

# API server configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# CORS (Cross-Origin Resource Sharing) settings
CORS_ORIGINS=*
CORS_METHODS=GET,POST
CORS_HEADERS=*

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================

# Model configuration
MODEL_PATH=./models/voice_classifier.joblib
MODEL_CONFIDENCE_THRESHOLD=0.5

# =============================================================================
# AUDIO PROCESSING SETTINGS
# =============================================================================

# Audio processing settings
MAX_AUDIO_SIZE_MB=10
MAX_AUDIO_DURATION_SECONDS=30
MIN_AUDIO_DURATION_SECONDS=2

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================

# Rate limiting settings
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_ENABLED=true

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Security configuration
CORS_ORIGINS=*
CORS_METHODS=GET,POST
CORS_HEADERS=*

# =============================================================================
# MONITORING AND HEALTH CHECKS
# =============================================================================

# Monitoring and health check settings
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true
PROMETHEUS_PORT=9090

# =============================================================================
# OPTIONAL EXTERNAL SERVICES
# =============================================================================

# Optional database configuration (for logging/analytics)
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_voice_detector

# Optional external services
# SENTRY_DSN=https://your-sentry-dsn
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# FEATURE FLAGS AND DEVELOPMENT SETTINGS
# =============================================================================

# Feature flags
ENABLE_DETAILED_LOGGING=false
ENABLE_FEATURE_IMPORTANCE=true
ENABLE_BATCH_PROCESSING=false

# =============================================================================
# PRODUCTION DEPLOYMENT NOTES
# =============================================================================
#
# For production deployment:
# 1. Run: python scripts/configure_production_env.py --interactive
# 2. Or copy: cp .env.production .env
# 3. Validate: python scripts/validate_production_config.py
# 4. See: docs/PRODUCTION_ENVIRONMENT_GUIDE.md
#
# Security checklist for production:
# - Set ENVIRONMENT=production
# - Set DEBUG=false  
# - Set LOG_LEVEL=INFO or higher
# - Specify exact CORS_ORIGINS (not *)
# - Generate secure API_KEY and JWT_SECRET
# - Ensure MODEL_PATH points to trained model
# - Enable rate limiting and monitoring
#
# =============================================================================